---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <strong>Cleaning by Cassi</strong>
      <p>A cleaner home, without the stress. 💗</p>
    </div>

    <div class="footer-links">
      <a href="/services">Services</a>
      <a href="/pricing">Pricing</a>
      <a href="/quote">Free Quote</a>
      <a href="https://facebook.com/cleaningbycassi" target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
  </div>

  <div class="footer-bottom">
    &copy; {today.getFullYear()} Cleaning by Cassi. All rights reserved.
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 3rem 1rem 2rem;
    color: var(--ink);
    background: linear-gradient(135deg, rgba(245, 200, 223, 0.55), rgba(230, 220, 248, 0.62), rgba(224, 243, 227, 0.62));
    border-top: 1px solid rgba(166, 75, 181, 0.12);
  }

  .footer-inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-inner strong {
    font-family: 'DM Serif Display', serif;
    font-size: 1.6rem;
    font-weight: 400;
  }

  .footer-inner p {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    justify-content: flex-end;
  }

  .footer-links a {
    color: var(--purple-dark);
    font-weight: 600;
  }

  .footer-bottom {
    width: min(1180px, 100%);
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(48, 41, 54, 0.1);
    color: var(--muted);
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 700px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
    .footer-links { justify-content: center; }
  }
</style>
