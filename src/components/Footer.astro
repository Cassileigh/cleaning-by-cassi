---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <strong>Cleaning by Cassi</strong>
      <p>A cleaner home, without the stress. 💗</p>
    </div>

    <div class="footer-links">
      <a href="/services">Services</a>
      <a href="/pricing">Pricing</a>
      <a href="/quote">Free Quote</a>
      <a
        href="https://facebook.com/cleaningbycassi"
        target="_blank"
        rel="noopener noreferrer">Facebook</a
      >
    </div>
  </div>

  <div class="footer-divider-row" aria-hidden="true">
    <span class="footer-divider"></span>

    <div class="footer-ornament">
      <svg viewBox="0 0 700 160" role="presentation" focusable="false">
        <defs>
          <linearGradient id="ornPink" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#ff6bc5"></stop>
            <stop offset="52%" stop-color="#f24bb5"></stop>
            <stop offset="100%" stop-color="#d92db1"></stop>
          </linearGradient>
          <linearGradient id="ornGreen" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#d7ff4b"></stop>
            <stop offset="48%" stop-color="#a7df24"></stop>
            <stop offset="100%" stop-color="#67a824"></stop>
          </linearGradient>
          <filter id="ornGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="2.4" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
        </defs>

        <!-- Left double flourish, matching the card's curled ornamental stroke -->
        <g
          fill="none"
          stroke="url(#ornPink)"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            stroke-width="8"
            d="M22 88c28-30 70-38 112-19 32 14 51 36 83 37 24 1 43-11 63-28"
          ></path>
          <path
            stroke-width="5"
            d="M38 95c20 22 48 22 69 5 17-13 14-35-5-43-17-7-35 2-38 18-3 15 8 26 22 26"
          ></path>
          <path stroke-width="5" d="M101 58c29-16 62-13 91 7 25 18 42 27 67 26"
          ></path>
          <path
            stroke-width="3.5"
            d="M126 68c27-8 53-2 76 17 16 13 32 18 51 18"
            opacity=".75"></path>
        </g>

        <!-- Right flourish mirrors the business card -->
        <g
          fill="none"
          stroke="url(#ornPink)"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            stroke-width="8"
            d="M678 88c-28-30-70-38-112-19-32 14-51 36-83 37-24 1-43-11-63-28"
          ></path>
          <path
            stroke-width="5"
            d="M662 95c-20 22-48 22-69 5-17-13-14-35 5-43 17-7 35 2 38 18 3 15-8 26-22 26"
          ></path>
          <path stroke-width="5" d="M599 58c-29-16-62-13-91 7-25 18-42 27-67 26"
          ></path>
          <path
            stroke-width="3.5"
            d="M574 68c-27-8-53-2-76 17-16 13-32 18-51 18"
            opacity=".75"></path>
        </g>

        <!-- Colored bead details from the business card -->
        <g filter="url(#ornGlow)">
          <circle cx="246" cy="103" r="4" fill="#ff79c8"></circle>
          <circle cx="262" cy="108" r="5" fill="#f7bf4a"></circle>
          <circle cx="279" cy="112" r="5.5" fill="#a7df24"></circle>
          <circle cx="297" cy="114" r="4.5" fill="#d7ff4b"></circle>
          <circle cx="403" cy="114" r="4.5" fill="#d7ff4b"></circle>
          <circle cx="421" cy="112" r="5.5" fill="#a7df24"></circle>
          <circle cx="438" cy="108" r="5" fill="#f7bf4a"></circle>
          <circle cx="454" cy="103" r="4" fill="#ff79c8"></circle>
        </g>

        <!-- Three-leaf center motif -->
        <g
          fill="url(#ornGreen)"
          stroke="#7fba22"
          stroke-width="2"
          filter="url(#ornGlow)"
        >
          <path d="M350 124c-7-37-5-72 0-97 19 22 26 55 0 97Z"></path>
          <path d="M337 126c-36-8-59-30-69-61 37 1 63 21 69 61Z"></path>
          <path d="M363 126c36-8 59-30 69-61-37 1-63 21-69 61Z"></path>
        </g>
        <g
          fill="none"
          stroke="#f5ffd8"
          stroke-width="2.2"
          stroke-linecap="round"
          opacity=".65"
        >
          <path d="M350 111V47"></path>
          <path d="M331 114c-18-15-33-29-49-40"></path>
          <path d="M369 114c18-15 33-29 49-40"></path>
        </g>
      </svg>
    </div>

    <span class="footer-divider"></span>
  </div>

  <div class="footer-bottom">
    &copy; {today.getFullYear()} Cleaning by Cassi. All rights reserved.
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 3.4rem 1rem 2.2rem;
    color: var(--ink);
    background:
      radial-gradient(
        circle at 15% 20%,
        rgba(242, 75, 181, 0.14),
        transparent 28%
      ),
      radial-gradient(
        circle at 85% 15%,
        rgba(21, 72, 245, 0.14),
        transparent 30%
      ),
      linear-gradient(
        135deg,
        rgba(111, 20, 217, 0.09),
        rgba(167, 223, 36, 0.08)
      );
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-brand strong {
    font-family: 'DM Serif Display', serif;
    font-size: 1.6rem;
    font-weight: 400;
  }

  .footer-brand p {
    margin: 0.4rem 0 0;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.45rem;
    justify-content: flex-end;
  }

  .footer-links a {
    color: var(--purple);
    font-weight: 600;
  }

  .footer-links a:hover {
    color: var(--pink);
  }
  .footer-links a:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .footer-divider-row {
    width: min(1180px, 100%);
    margin: 1.8rem auto 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .footer-divider {
    height: 1px;
    background: var(--border);
  }

  .footer-ornament {
    width: min(430px, 48vw);
    line-height: 0;
  }

  .footer-ornament svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 6px 14px rgba(111, 20, 217, 0.12));
  }

  .footer-bottom {
    width: min(1180px, 100%);
    margin: 0.75rem auto 0;
    color: var(--muted);
    font-size: 0.82rem;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    .site-footer {
      background: linear-gradient(
        135deg,
        rgba(111, 20, 217, 0.16),
        rgba(21, 72, 245, 0.1),
        rgba(242, 75, 181, 0.11)
      );
    }
    .footer-links a {
      color: #d7baff;
    }
    .footer-ornament svg {
      filter: drop-shadow(0 7px 16px rgba(242, 75, 181, 0.18));
    }
  }

  @media (max-width: 700px) {
    .site-footer {
      margin-top: 2.5rem;
      padding: 2.5rem 1rem 2rem;
    }
    .footer-inner {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    .footer-links {
      justify-content: center;
      gap: 0.65rem 1rem;
    }
    .footer-divider-row {
      gap: 0.45rem;
      margin-top: 1.5rem;
    }
    .footer-ornament {
      width: min(360px, 76vw);
    }
  }
</style>
