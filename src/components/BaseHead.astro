---
import '../styles/global.css';
import DocumentMetadata from './DocumentMetadata.astro';
import '../styles/site-canvas.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title,
  description,
  image = '/social-share.jpg?v=business-card-2',
  noindex = false,
} = Astro.props;
const socialImageURL = new URL(image, Astro.site ?? Astro.url);
---

<DocumentMetadata
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  imageURL={socialImageURL}
  imageAlt="Cleaning by Cassi business card"
  viewport="width=device-width,initial-scale=1"
  robots={noindex ? 'noindex, follow' : undefined}
  titleMeta
  secureImage
  imageType="image/jpeg"
  imageWidth="1200"
  imageHeight="630"
  twitterProperty
  twitterURL
  icons={[
    {
      rel: 'icon',
      type: 'image/png',
      sizes: '32x32',
      href: '/favicon-32x32.png',
    },
    {
      rel: 'icon',
      type: 'image/png',
      sizes: '16x16',
      href: '/favicon-16x16.png',
    },
    { rel: 'icon', href: '/favicon.ico', sizes: 'any' },
    {
      rel: 'apple-touch-icon',
      sizes: '180x180',
      href: '/apple-touch-icon.png',
    },
    { rel: 'manifest', href: '/site.webmanifest' },
  ]}
  fonts={[
    { href: '/fonts/DMSerifDisplay-Regular.woff2', type: 'font/woff2' },
    { href: '/fonts/PoppinsRegular.woff2', type: 'font/woff2' },
  ]}
/>
