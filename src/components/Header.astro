---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---
<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} home`}>
      <img src="/header-logo.png" width="512" height="512" alt="Cleaning by Cassi" class="site-logo" decoding="async" />
    </a>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink><HeaderLink href="/about">About</HeaderLink><HeaderLink href="/services">Services</HeaderLink><HeaderLink href="/pricing">Pricing</HeaderLink><HeaderLink href="/quote">Get a Quote</HeaderLink>
    </div>
    <a href="https://facebook.com/cleaningbycassi" target="_blank" rel="noopener noreferrer" class="facebook-link" aria-label="Follow Cleaning by Cassi on Facebook"><svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.219l-.354 2.326H9.25v5.625c3.824-.604 6.75-3.934 6.75-7.951z"/></svg></a>
  </nav>
</header>
<style>
.site-header{position:sticky;top:0;z-index:100;padding:.65rem clamp(1rem,4vw,3rem);background:linear-gradient(90deg,rgba(7,16,77,.97),rgba(9,38,165,.95),rgba(39,17,111,.96));border-bottom:1px solid rgba(255,255,255,.12);box-shadow:0 6px 24px rgba(0,0,0,.16);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}.site-nav{width:min(1240px,100%);margin:auto;display:grid;grid-template-columns:minmax(180px,260px) 1fr 48px;align-items:center;gap:1.2rem}.brand{display:block;width:clamp(170px,18vw,245px);height:76px;overflow:hidden}.site-logo{display:block;width:100%;height:100%;object-fit:contain;object-position:left center}.internal-links{display:flex;align-items:center;justify-content:center;gap:.35rem;min-width:0}:global(.internal-links a){padding:.68rem .95rem;border-radius:999px;color:#fff;font-size:.92rem;font-weight:600;transition:.2s ease}:global(.internal-links a:hover){color:#fff;background:rgba(255,255,255,.1)}:global(.internal-links a.active){color:#fff;background:linear-gradient(100deg,#7024e8,#f536b7);box-shadow:0 8px 22px rgba(245,54,183,.24)}.facebook-link{display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(255,255,255,.22);border-radius:50%;color:#ff8ad8;background:rgba(255,255,255,.08)}
@media(max-width:860px){.site-nav{grid-template-columns:minmax(160px,220px) 1fr 44px}.brand{height:66px}.internal-links{order:3;grid-column:1/-1;width:100%;overflow-x:auto;justify-content:flex-start;scrollbar-width:none}.internal-links::-webkit-scrollbar{display:none}}
@media(max-width:520px){.site-header{padding:.45rem .7rem}.site-nav{grid-template-columns:1fr 42px;gap:.4rem}.brand{width:180px;height:58px}.facebook-link{display:grid}.internal-links{grid-column:1/-1;margin-inline:-.7rem;width:calc(100% + 1.4rem);padding:.2rem .7rem .35rem;gap:.15rem}:global(.internal-links a){flex:0 0 auto;font-size:.82rem;padding:.52rem .68rem;white-space:nowrap}}
</style>