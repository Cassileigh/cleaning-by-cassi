---
import type { HTMLAttributes } from 'astro/types';
import { isNavigationActive } from '../navigation-link';

type Props = HTMLAttributes<'a'> & { reload?: boolean };

const { href, class: className, reload, ...props } = Astro.props;
const isActive = isNavigationActive(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
  href,
);
---

<a
  tabindex="0"
  href={href}
  data-astro-reload={reload}
  aria-current={isActive ? 'page' : undefined}
  class:list={[className, { active: isActive }]}
  {...props}
>
  <slot />
</a>
<style>
  a {
    display: inline-block;
    text-decoration: none;
  }
  a.active {
    font-weight: bolder;
    text-decoration: underline;
  }
</style>
