---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import { SITE_TITLE, SITE_DESCRIPTION, OWNER_NAME, SERVICE_AREA } from '../consts';
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />

    <main class="home">
      <section class="hero">
        <div class="hero-brand-art" aria-hidden="true">
          <svg class="hero-overlay" viewBox="0 0 1200 760" preserveAspectRatio="none" focusable="false">
            <g class="overlay-sparkles">
              <path d="M1045 70c7 34 22 49 56 56-34 7-49 22-56 56-7-34-22-49-56-56 34-7 49-22 56-56Z" />
              <path d="M1135 155c4 20 13 29 33 33-20 4-29 13-33 33-4-20-13-29-33-33 20-4 29-13 33-33Z" />
              <path d="M930 112c3 15 10 22 25 25-15 3-22 10-25 25-3-15-10-22-25-25 15-3 22-10 25-25Z" />
            </g>

            <g class="overlay-spray">
              <path d="M1010 260h74l36 25-15 27-40-18-14 38v27c30 10 50 37 50 69v31H981v-31c0-32 20-59 50-69v-25l-21-74Z" />
              <path d="M1026 230h64v30h-64z" />
              <path d="M1090 245h44" />
              <path d="M1135 245l27-14M1135 245l30 4M1135 245l23 22" />
            </g>

            <g class="overlay-leaves">
              <path d="M850 735c86-76 165-141 272-210" />
              <path d="M920 655c-48-3-78-27-84-62 53-3 88 17 104 57" />
              <path d="M993 594c-12-41 11-74 50-91 24 42 11 76-33 102" />
              <path d="M1082 535c27-32 65-43 103-27-18 44-54 62-99 49" />
            </g>

            <g class="overlay-flourish">
              <path d="M640 704c93-66 181-42 243-2 63 41 134 41 208-2 41-24 79-30 117-25" />
              <path d="M650 712c39 28 86 24 115-10" />
              <path d="M1180 706c-24 13-50 15-78 6" />
              <circle cx="946" cy="701" r="8" />
            </g>
          </svg>
        </div>

        <div class="hero-copy">
          <p class="eyebrow">Cleaning by Cassi</p>
          <h1>A cleaner home.<span>A little more breathing room.</span></h1>
          <p class="lead">Dependable, detailed residential cleaning for busy families throughout the Fox Cities.</p>
          <div class="actions">
            <a class="button primary" href="/quote">Get a Free Quote</a>
            <a class="button secondary" href="/services">Explore Services</a>
          </div>
          <div class="trust"><span>✓ Personalized</span><span>✓ Detailed</span><span>✓ Pet-friendly</span></div>
        </div>

        <div class="hero-visual">
          <div class="visual-note visual-note-top">
            <span aria-hidden="true">✨</span>
            <div><strong>Detailed care, done personally.</strong><small>One cleaner. One familiar face. One home at a time.</small></div>
          </div>

          <div class="hero-photo">
            <picture>
              <source srcset="/homepage-optimized.avif" type="image/avif" />
              <source srcset="/homepage-optimized.webp" type="image/webp" />
              <img src="/homepage.jpg" alt="Cleaning by Cassi accepting new clients" loading="eager" fetchpriority="high" decoding="async" />
            </picture>
          </div>

          <div class="visual-note visual-note-bottom">
            <span aria-hidden="true">💗</span>
            <div><strong>Locally owned in the Fox Cities</strong><small>Personalized • dependable • pet-friendly</small></div>
          </div>
        </div>
      </section>

      <section class="new-client-banner">
        <div>
          <p class="eyebrow">✨ Now Accepting New Clients ✨</p>
          <h2>Ready for a cleaner home?</h2>
          <p>I'd love to help make your home a little easier to keep up with.</p>
        </div>
        <a href="/quote" class="button primary">Get Your Free Quote →</a>
      </section>

      <section class="split intro">
        <div class="soft-art">✨<span>Fresh spaces.<br />More free time.</span></div>
        <div>
          <p class="eyebrow">Hi, I'm Cassi! 👋</p>
          <h2>More than a clean home — <em>more time for what matters.</em></h2>
          <p>Life gets busy. Between work, family, pets, and everything else on your plate, keeping up with the house can feel overwhelming.</p>
          <p>That's where I come in. My goal isn't just to make your home clean — it's to make your life a little easier.</p>
          <a class="text-link" href="/about">Meet {OWNER_NAME} →</a>
        </div>
      </section>

      <section class="services">
        <div class="heading">
          <p class="eyebrow">What I Do</p>
          <h2>Cleaning that fits <em>your home & your life.</em></h2>
          <p>Every home is different, which is why your cleaning should be, too.</p>
        </div>
        <div class="cards">
          <article><span>🧽</span><h3>Standard Cleaning</h3><p>Regular upkeep to keep your home fresh, comfortable, and clean.</p></article>
          <article class="featured"><span>✨</span><h3>Deep Cleaning</h3><p>A detailed reset for homes that need a little extra TLC.</p></article>
          <article><span>🏡</span><h3>Recurring Cleaning</h3><p>Weekly, biweekly, or monthly visits to keep your home under control.</p></article>
          <article><span>➕</span><h3>Add-On Services</h3><p>Customize your clean with extras like baseboards, bed making, laundry, and more.</p></article>
        </div>
        <div class="center"><a class="button secondary" href="/services">See All Services →</a></div>
      </section>

      <section class="why">
        <div>
          <p class="eyebrow">Why Cleaning by Cassi?</p>
          <h2>Your home deserves <em>personal attention.</em></h2>
          <p>When you invite someone into your home, you want to know you can trust them. I provide dependable, detailed cleaning with a personal touch.</p>
        </div>
        <div class="features">
          <div>💗 <strong>Personalized</strong><small>Your home and needs are unique.</small></div>
          <div>✨ <strong>Detail-focused</strong><small>The little things matter.</small></div>
          <div>🐾 <strong>Pet-friendly</strong><small>Four-legged family members are welcome.</small></div>
          <div>💚 <strong>Personal</strong><small>You'll know who's caring for your home.</small></div>
        </div>
      </section>

      <Testimonials />

      <section class="final-cta">
        <p class="eyebrow">Ready for a fresh start?</p>
        <h2>Ready to love <em>coming home again?</em></h2>
        <p>Let's find the cleaning plan that's right for your home in the {SERVICE_AREA} area.</p>
        <a href="/quote" class="button light">Get My Free Quote →</a>
        <small>No pressure. Just a simple quote tailored to your home.</small>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .home { padding:0; overflow:hidden; }
  .home section { padding:clamp(3.5rem,7vw,6.5rem); }

  .hero {
    position:relative;
    isolation:isolate;
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:4rem;
    align-items:stretch;
    overflow:hidden;
    background:var(--surface-solid);
  }

  .hero > :not(.hero-brand-art) { position:relative; z-index:2; }
  .hero-brand-art { position:absolute; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
  .hero-overlay { position:absolute; inset:0; width:100%; height:100%; fill:none; stroke-linecap:round; stroke-linejoin:round; }
  .overlay-sparkles { color:var(--pink); stroke:currentColor; stroke-width:4; opacity:.14; }
  .overlay-spray { color:var(--pink); stroke:currentColor; stroke-width:4; opacity:.075; }
  .overlay-leaves { color:var(--green-bright); stroke:currentColor; stroke-width:5; opacity:.10; }
  .overlay-flourish { color:var(--green-bright); stroke:currentColor; stroke-width:4; opacity:.08; }

  .hero-copy { align-self:center; min-width:0; }
  .hero h1 span,.home em { display:block; color:var(--purple); font-style:normal; }
  .lead { max-width:620px; color:var(--muted); font-size:1.08rem; line-height:1.8; }
  .actions,.trust { display:flex; gap:1rem; flex-wrap:wrap; }
  .actions { margin:2rem 0; }
  .trust { color:var(--muted); font-size:.86rem; font-weight:600; }

  .button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:.9rem 1.5rem; border-radius:999px; font-weight:700; transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease,color .2s ease; }
  .primary { background:var(--brand-gradient); color:white; box-shadow:0 10px 28px rgba(111,20,217,.24); }
  .primary:hover { color:white; transform:translateY(-2px); }
  .secondary { border:2px solid var(--purple); color:var(--ink); background:var(--surface-solid); }
  .secondary:hover { color:var(--purple); background:var(--lavender-soft); }
  .button:focus-visible,.text-link:focus-visible { outline:3px solid var(--pink); outline-offset:4px; }

  .hero-visual { min-width:0; display:flex; flex-direction:column; justify-content:center; gap:1rem; padding:.5rem 0; }
  .hero-photo { min-width:0; width:100%; }
  .hero-photo picture { display:block; width:100%; }
  .hero-photo img { display:block; width:100%; height:auto; min-height:0; object-fit:contain; border-radius:32px; box-shadow:var(--shadow); }

  .visual-note { display:flex; align-items:center; gap:.85rem; padding:.95rem 1rem; border:1px solid var(--border); border-radius:20px; background:var(--surface); box-shadow:0 10px 26px rgba(49,24,95,.08); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); }
  .visual-note > span { display:grid; place-items:center; width:42px; height:42px; flex:0 0 42px; border-radius:50%; background:var(--brand-gradient-soft); font-size:1.2rem; }
  .visual-note div { min-width:0; }
  .visual-note strong,.visual-note small { display:block; }
  .visual-note strong { color:var(--ink); font-size:.92rem; line-height:1.35; }
  .visual-note small { margin-top:.18rem; color:var(--muted); font-size:.76rem; line-height:1.45; }
  .visual-note-bottom { margin-inline:1.25rem; }

  .new-client-banner { display:flex; align-items:center; justify-content:space-between; gap:2rem; background:var(--brand-gradient-soft); border-block:1px solid var(--border); }
  .new-client-banner h2 { font-size:clamp(2rem,4vw,3rem); }
  .new-client-banner p { margin-bottom:0; }

  .split { display:grid; grid-template-columns:.85fr 1.15fr; gap:4rem; align-items:center; }
  .soft-art { min-height:380px; border-radius:32px; background:radial-gradient(circle at 25% 25%,rgba(167,223,36,.20),transparent 30%),linear-gradient(145deg,var(--lavender-soft),var(--surface-soft)); border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; font-size:3rem; }
  .soft-art span { font-family:'DM Serif Display',serif; font-size:2rem; margin-top:1rem; }
  .split p { color:var(--muted); line-height:1.85; }
  .text-link { font-weight:700; }

  .services { background:var(--surface-soft); }
  .heading { max-width:760px; margin:0 auto 3rem; text-align:center; }
  .heading > p:last-child { color:var(--muted); }
  .cards { display:grid; grid-template-columns:repeat(4,1fr); gap:1.2rem; }
  .cards article { padding:2rem; border:1px solid var(--border); border-radius:24px; background:var(--surface-solid); box-shadow:0 10px 30px rgba(49,24,95,.08); }
  .cards article > span { font-size:2rem; }
  .cards article p { color:var(--muted); }
  .cards .featured { background:var(--brand-gradient); color:white; border-color:transparent; }
  .featured h3,.featured p { color:white!important; }
  .center { text-align:center; margin-top:2.5rem; }

  .why { display:grid; grid-template-columns:1fr 1fr; gap:4rem; background:linear-gradient(145deg,rgba(167,223,36,.14),rgba(111,20,217,.08)); }
  .why > div > p:not(.eyebrow) { color:var(--muted); }
  .features { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .features div { padding:1.3rem; border:1px solid var(--border); border-radius:20px; background:var(--surface); }
  .features strong,.features small { display:block; }
  .features small { margin-top:.3rem; color:var(--muted); }

  .final-cta { text-align:center; color:white; background:var(--brand-gradient); }
  .final-cta h2,.final-cta .eyebrow,.final-cta p { color:white; }
  .final-cta em { color:var(--green-bright); }
  .final-cta small { display:block; margin-top:1rem; opacity:.9; }
  .light { margin-top:1rem; background:white; color:var(--purple-dark); }

  @media (prefers-color-scheme:dark) {
    .secondary { background:rgba(255,255,255,.04); border-color:#b78cff; }
    .cards article { box-shadow:0 10px 30px rgba(0,0,0,.22); }
    .visual-note { background:rgba(255,255,255,.05); }
    .overlay-sparkles { opacity:.20; }
    .overlay-spray { opacity:.10; }
    .overlay-leaves { opacity:.14; }
    .overlay-flourish { opacity:.11; }
  }

  @media (max-width:900px) {
    .hero,.split,.why { grid-template-columns:1fr; }
    .cards { grid-template-columns:1fr 1fr; }
    .hero-visual { order:-1; padding:0; }
    .visual-note { display:none; }
    .new-client-banner { flex-direction:column; align-items:flex-start; }
    .hero-overlay { transform:translateX(8%) scale(1.05); transform-origin:center; }
    .overlay-spray { opacity:.05; }
    .overlay-flourish { opacity:.06; }
  }

  @media (max-width:600px) {
    .home section { padding:2.25rem 1.25rem; }
    .hero { gap:1.6rem; padding-top:1.25rem!important; }
    .hero-photo { width:100%; }
    .hero-photo img { width:100%; height:auto; min-height:0; border-radius:24px; }
    .hero-copy { min-width:0; }
    .hero-copy .eyebrow { display:none; }
    .hero h1 { font-size:clamp(2.55rem,12vw,4rem); line-height:1.02; margin:0; overflow-wrap:normal; word-break:normal; }
    .hero h1 span { margin-top:.35rem; }
    .lead { font-size:1.05rem; line-height:1.65; margin-top:1.25rem; }
    .actions { margin:1.5rem 0; gap:.75rem; }
    .actions .button { width:100%; min-height:52px; }
    .trust { display:grid; grid-template-columns:repeat(3,auto); justify-content:center; gap:.45rem .8rem; font-size:.78rem; }
    .cards,.features { grid-template-columns:1fr; }
    .new-client-banner { text-align:center; align-items:center; }
    .new-client-banner .button { width:100%; }
    .soft-art { min-height:260px; }
    .soft-art span { font-size:1.7rem; }
    .final-cta .button { width:100%; }
    .hero-overlay { transform:translateX(16%) scale(1.12); }
    .overlay-spray { display:none; }
    .overlay-leaves { opacity:.06; }
    .overlay-flourish { opacity:.04; }
    .overlay-sparkles { opacity:.08; }
  }

  @media (max-width:390px) {
    .hero h1 { font-size:2.45rem; }
    .trust { grid-template-columns:1fr; justify-items:center; }
  }

  @media (prefers-reduced-motion:reduce) {
    .button { transition:none; }
  }
</style>