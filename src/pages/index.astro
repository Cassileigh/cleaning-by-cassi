---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import { SITE_TITLE, SITE_DESCRIPTION, OWNER_NAME, SERVICE_AREA } from '../consts';
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />

    <main class="home">
      <section class="hero">
        <div class="hero-brand-art" aria-hidden="true">
          <svg class="hero-overlay" viewBox="0 0 1400 820" preserveAspectRatio="none" focusable="false">
            <defs>
              <radialGradient id="bubbleFill" cx="32%" cy="28%" r="75%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity=".22" />
                <stop offset="46%" stop-color="#d9c9f6" stop-opacity=".08" />
                <stop offset="100%" stop-color="#8f70ca" stop-opacity=".02" />
              </radialGradient>
            </defs>

            <g class="overlay-top-leaf">
              <path d="M1028 182c76-80 157-122 251-130"/>
              <path d="M1126 111c-38-8-63-30-68-61 45 0 75 18 87 55"/>
              <path d="M1195 78c-8-36 10-65 45-80 21 37 9 67-30 89"/>
              <path d="M1264 58c20-31 50-45 84-37-9 40-38 61-78 57"/>
              <path d="M1321 64c31-22 66-22 96 0-24 34-58 44-96 27"/>
            </g>

            <g class="overlay-bottom-leaf">
              <path d="M1122 878c83-74 160-139 269-207"/>
              <path d="M1190 800c-45-4-74-26-81-60 50-3 83 16 98 55"/>
              <path d="M1263 740c-11-39 11-71 49-87 23 40 10 73-32 98"/>
              <path d="M1345 684c26-30 62-41 98-26-17 42-51 59-93 47"/>
            </g>

            <g class="overlay-bubbles">
              <g transform="translate(735 110)"><circle r="20"/><path d="M-7-8c4-6 10-8 16-5" class="bubble-shine"/></g>
              <g transform="translate(900 178)"><circle r="31"/><path d="M-11-13c7-8 16-10 25-6" class="bubble-shine"/></g>
              <g transform="translate(1320 255)"><circle r="18"/><path d="M-6-7c4-5 9-6 14-3" class="bubble-shine"/></g>
              <g transform="translate(1360 610)"><circle r="35"/><path d="M-12-14c8-9 18-11 28-6" class="bubble-shine"/></g>
              <g transform="translate(1040 755)"><circle r="16"/><path d="M-5-6c3-4 8-5 12-3" class="bubble-shine"/></g>
              <g transform="translate(735 688)"><circle r="24"/><path d="M-8-10c5-6 12-8 19-4" class="bubble-shine"/></g>
            </g>
          </svg>
        </div>
        <div class="hero-copy"><p class="eyebrow">Cleaning by Cassi</p><h1>A cleaner home.<span>A little more breathing room.</span></h1><p class="lead">Dependable, detailed residential cleaning for busy families throughout the Fox Cities.</p><div class="actions"><a class="button primary" href="/quote">Get a Free Quote</a><a class="button secondary" href="/services">Explore Services</a></div><div class="trust"><span>✓ Personalized</span><span>✓ Detailed</span><span>✓ Pet-friendly</span></div></div>
        <div class="hero-visual"><div class="visual-note visual-note-top"><span aria-hidden="true">✨</span><div><strong>Detailed care, done personally.</strong><small>One cleaner. One familiar face. One home at a time.</small></div></div><div class="hero-photo"><picture><source srcset="/homepage-optimized.avif" type="image/avif"/><source srcset="/homepage-optimized.webp" type="image/webp"/><img src="/homepage.jpg" alt="Cleaning by Cassi accepting new clients" loading="eager" fetchpriority="high" decoding="async"/></picture></div><div class="visual-note visual-note-bottom"><span aria-hidden="true">💗</span><div><strong>Locally owned in the Fox Cities</strong><small>Personalized • dependable • pet-friendly</small></div></div></div>
      </section>
      <section class="new-client-banner"><div><p class="eyebrow">✨ Now Accepting New Clients ✨</p><h2>Ready for a cleaner home?</h2><p>I'd love to help make your home a little easier to keep up with.</p></div><a href="/quote" class="button primary">Get Your Free Quote →</a></section>
      <section class="split intro"><div class="soft-art">✨<span>Fresh spaces.<br/>More free time.</span></div><div><p class="eyebrow">Hi, I'm Cassi! 👋</p><h2>More than a clean home — <em>more time for what matters.</em></h2><p>Life gets busy. Between work, family, pets, and everything else on your plate, keeping up with the house can feel overwhelming.</p><p>That's where I come in. My goal isn't just to make your home clean — it's to make your life a little easier.</p><a class="text-link" href="/about">Meet {OWNER_NAME} →</a></div></section>
      <section class="services"><div class="heading"><p class="eyebrow">What I Do</p><h2>Cleaning that fits <em>your home & your life.</em></h2><p>Every home is different, which is why your cleaning should be, too.</p></div><div class="cards"><article><span>🧽</span><h3>Standard Cleaning</h3><p>Regular upkeep to keep your home fresh, comfortable, and clean.</p></article><article class="featured"><span>✨</span><h3>Deep Cleaning</h3><p>A detailed reset for homes that need a little extra TLC.</p></article><article><span>🏡</span><h3>Recurring Cleaning</h3><p>Weekly, biweekly, or monthly visits to keep your home under control.</p></article><article><span>➕</span><h3>Add-On Services</h3><p>Customize your clean with extras like baseboards, bed making, laundry, and more.</p></article></div><div class="center"><a class="button secondary" href="/services">See All Services →</a></div></section>
      <section class="why"><div><p class="eyebrow">Why Cleaning by Cassi?</p><h2>Your home deserves <em>personal attention.</em></h2><p>When you invite someone into your home, you want to know you can trust them. I provide dependable, detailed cleaning with a personal touch.</p></div><div class="features"><div>💗 <strong>Personalized</strong><small>Your home and needs are unique.</small></div><div>✨ <strong>Detail-focused</strong><small>The little things matter.</small></div><div>🐾 <strong>Pet-friendly</strong><small>Four-legged family members are welcome.</small></div><div>💚 <strong>Personal</strong><small>You'll know who's caring for your home.</small></div></div></section>
      <Testimonials />
      <section class="final-cta"><p class="eyebrow">Ready for a fresh start?</p><h2>Ready to love <em>coming home again?</em></h2><p>Let's find the cleaning plan that's right for your home in the {SERVICE_AREA} area.</p><a href="/quote" class="button light">Get My Free Quote →</a><small>No pressure. Just a simple quote tailored to your home.</small></section>
    </main><Footer />
  </body>
</html>
<style>
.home{padding:0;overflow:visible}.home section{padding:clamp(3.5rem,7vw,6.5rem)}
.hero{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(2.5rem,5vw,6rem);align-items:stretch;overflow:hidden;background:var(--surface-solid);width:100vw;margin-inline:calc(50% - 50vw);padding-inline:clamp(2rem,6vw,7rem)!important}
.hero>:not(.hero-brand-art){position:relative;z-index:2}.hero-brand-art{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}.hero-overlay{position:absolute;inset:0;width:100%;height:100%;fill:none;stroke-linecap:round;stroke-linejoin:round}
.overlay-top-leaf,.overlay-bottom-leaf{color:#5f8d36;stroke:currentColor;stroke-width:6;opacity:.28}.overlay-bubbles circle{fill:url(#bubbleFill);stroke:#8f70ca;stroke-width:4;opacity:.36}.overlay-bubbles .bubble-shine{fill:none;stroke:#fff;stroke-width:3;opacity:.28}
.hero-copy{align-self:center;min-width:0;max-width:650px}.hero h1 span,.home em{display:block;color:var(--purple);font-style:normal}.lead{max-width:620px;color:var(--muted);font-size:1.08rem;line-height:1.8}.actions,.trust{display:flex;gap:1rem;flex-wrap:wrap}.actions{margin:2rem 0}.trust{color:var(--muted);font-size:.86rem;font-weight:600}
.button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.9rem 1.5rem;border-radius:999px;font-weight:700;transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease,color .2s ease}.primary{background:var(--brand-gradient);color:white;box-shadow:0 10px 28px rgba(111,20,217,.24)}.primary:hover{color:white;transform:translateY(-2px)}.secondary{border:2px solid var(--purple);color:var(--ink);background:var(--surface-solid)}.secondary:hover{color:var(--purple);background:var(--lavender-soft)}.button:focus-visible,.text-link:focus-visible{outline:3px solid var(--pink);outline-offset:4px}
.hero-visual{min-width:0;display:flex;flex-direction:column;justify-content:center;gap:1rem;padding:.5rem 0;max-width:620px;justify-self:end;width:100%}.hero-photo,.hero-photo picture{display:block;width:100%;min-width:0}.hero-photo img{display:block;width:100%;height:auto;object-fit:contain;border-radius:32px;box-shadow:var(--shadow)}
.visual-note{display:flex;align-items:center;gap:.85rem;padding:.95rem 1rem;border:1px solid var(--border);border-radius:20px;background:var(--surface);box-shadow:0 10px 26px rgba(49,24,95,.08);backdrop-filter:blur(10px)}.visual-note>span{display:grid;place-items:center;width:42px;height:42px;flex:0 0 42px;border-radius:50%;background:var(--brand-gradient-soft);font-size:1.2rem}.visual-note strong,.visual-note small{display:block}.visual-note strong{color:var(--ink);font-size:.92rem}.visual-note small{margin-top:.18rem;color:var(--muted);font-size:.76rem}.visual-note-bottom{margin-inline:1.25rem}
.new-client-banner{display:flex;align-items:center;justify-content:space-between;gap:2rem;background:var(--brand-gradient-soft);border-block:1px solid var(--border)}.new-client-banner h2{font-size:clamp(2rem,4vw,3rem)}.new-client-banner p{margin-bottom:0}.split{display:grid;grid-template-columns:.85fr 1.15fr;gap:4rem;align-items:center}.soft-art{min-height:380px;border-radius:32px;background:radial-gradient(circle at 25% 25%,rgba(167,223,36,.20),transparent 30%),linear-gradient(145deg,var(--lavender-soft),var(--surface-soft));border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-size:3rem}.soft-art span{font-family:'DM Serif Display',serif;font-size:2rem;margin-top:1rem}.split p{color:var(--muted);line-height:1.85}.text-link{font-weight:700}.services{background:var(--surface-soft)}.heading{max-width:760px;margin:0 auto 3rem;text-align:center}.heading>p:last-child{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}.cards article{padding:2rem;border:1px solid var(--border);border-radius:24px;background:var(--surface-solid);box-shadow:0 10px 30px rgba(49,24,95,.08)}.cards article>span{font-size:2rem}.cards article p{color:var(--muted)}.cards .featured{background:var(--brand-gradient);color:white;border-color:transparent}.featured h3,.featured p{color:white!important}.center{text-align:center;margin-top:2.5rem}.why{display:grid;grid-template-columns:1fr 1fr;gap:4rem;background:linear-gradient(145deg,rgba(167,223,36,.14),rgba(111,20,217,.08))}.why>div>p:not(.eyebrow){color:var(--muted)}.features{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.features div{padding:1.3rem;border:1px solid var(--border);border-radius:20px;background:var(--surface)}.features strong,.features small{display:block}.features small{margin-top:.3rem;color:var(--muted)}.final-cta{text-align:center;color:white;background:var(--brand-gradient)}.final-cta h2,.final-cta .eyebrow,.final-cta p{color:white}.final-cta em{color:var(--green-bright)}.final-cta small{display:block;margin-top:1rem;opacity:.9}.light{margin-top:1rem;background:white;color:var(--purple-dark)}
@media(prefers-color-scheme:dark){.secondary{background:rgba(255,255,255,.04);border-color:#b78cff}.cards article{box-shadow:0 10px 30px rgba(0,0,0,.22)}.visual-note{background:rgba(255,255,255,.05)}.overlay-top-leaf,.overlay-bottom-leaf{color:var(--green-bright);opacity:.22}.overlay-bubbles circle{stroke:#b79ae6;opacity:.42}.overlay-bubbles .bubble-shine{opacity:.34}}
@media(max-width:900px){.hero,.split,.why{grid-template-columns:1fr}.hero{width:100vw;margin-inline:calc(50% - 50vw);padding-inline:clamp(1.5rem,5vw,3rem)!important}.cards{grid-template-columns:1fr 1fr}.hero-visual{order:-1;padding:0;justify-self:stretch;max-width:none}.visual-note{display:none}.new-client-banner{flex-direction:column;align-items:flex-start}.hero-overlay{transform:translateX(5%) scale(1.03);transform-origin:center}.overlay-top-leaf{opacity:.18}.overlay-bottom-leaf{opacity:.15}.overlay-bubbles circle{opacity:.28}}
@media(max-width:600px){.home{overflow:hidden}.home section{padding:2.25rem 1.25rem}.hero{width:100%;margin-inline:0;gap:1.6rem;padding:1.25rem 1.25rem 2.25rem!important}.hero-photo img{border-radius:24px}.hero-copy .eyebrow{display:none}.hero h1{font-size:clamp(2.55rem,12vw,4rem);line-height:1.02;margin:0}.hero h1 span{margin-top:.35rem}.lead{font-size:1.05rem;line-height:1.65;margin-top:1.25rem}.actions{margin:1.5rem 0;gap:.75rem}.actions .button{width:100%;min-height:52px}.trust{display:grid;grid-template-columns:repeat(3,auto);justify-content:center;gap:.45rem .8rem;font-size:.78rem}.cards,.features{grid-template-columns:1fr}.new-client-banner{text-align:center;align-items:center}.new-client-banner .button,.final-cta .button{width:100%}.soft-art{min-height:260px}.soft-art span{font-size:1.7rem}.hero-overlay{transform:none}.overlay-top-leaf,.overlay-bottom-leaf,.overlay-bubbles{display:none}}
@media(max-width:390px){.hero h1{font-size:2.45rem}.trust{grid-template-columns:1fr;justify-items:center}}@media(prefers-reduced-motion:reduce){.button{transition:none}}
</style>