---
import PageLayout from '../layouts/PageLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceAreaContact from '../components/ServiceAreaContact.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  OWNER_NAME,
  SERVICE_AREA,
} from '../consts';
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} class="home">
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-photo"
      src="/cleaned-living-room.webp"
      alt="Freshly cleaned living room with vacuumed carpet, polished wood furniture, and a tidy kitchen beyond"
      width="1312"
      height="1199"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-leaves hero-leaves-top" aria-hidden="true">
      ⌁
    </div>
    <div class="hero-leaves hero-leaves-bottom" aria-hidden="true">
      ⌁
    </div>

    <div class="hero-content">
      <p class="hero-eyebrow">CLEANING BY CASSI</p>
      <h1 id="hero-title">
        <span>Accepting</span>
        <strong>NEW CLIENTS</strong>
      </h1>
      <p class="hero-tagline">
        Done with precision.
        <br />
        Peace of mind delivered.
      </p>

      <div class="hero-benefits" aria-label="Cleaning by Cassi benefits">
        <div>
          <span aria-hidden="true">⌂</span>
          <small>
            A CLEANER
            <br />
            HOME
          </small>
        </div>
        <div>
          <span aria-hidden="true">♡</span>
          <small>
            A HAPPIER
            <br />
            YOU
          </small>
        </div>
        <div>
          <span aria-hidden="true">♧</span>
          <small>
            MORE TIME FOR
            <br />
            WHAT MATTERS
          </small>
        </div>
      </div>

      <a class="button hero-quote" href="/quote">
        Get a Free Quote <span aria-hidden="true">→</span>
      </a>
      <p class="hero-note">Because a clean home feels good ♡</p>
    </div>
  </section>

  <section class="intro section">
    <div>
      <p class="eyebrow">HI, I'M CASSI! 👋</p>
      <h2>
        A cleaner home means <em>more time for what matters.</em>
      </h2>
    </div>
    <div>
      <p>
        Life gets busy. Between work, family, pets, and everything else on your
        plate, keeping up with the house can feel like one more thing to manage.
      </p>
      <p>
        That's where I come in. My goal isn't just to make your home clean —
        it's to make your life a little easier.
      </p>
      <a class="text-link" href="/about">
        Meet {OWNER_NAME} →
      </a>
    </div>
  </section>

  <section class="services section">
    <div class="heading">
      <p class="eyebrow">WHAT I DO</p>
      <h2>
        Cleaning that fits <em>your home & your life.</em>
      </h2>
      <p>Every home is different, which is why your cleaning should be, too.</p>
    </div>
    <div class="cards">
      <article>
        <span>🧽</span>
        <h3>Standard Cleaning</h3>
        <p>Regular upkeep to keep your home fresh, comfortable, and clean.</p>
      </article>
      <article class="featured">
        <span>✨</span>
        <h3>Deep Cleaning</h3>
        <p>A detailed reset for homes that need a little extra TLC.</p>
      </article>
      <article>
        <span>🏡</span>
        <h3>Recurring Cleaning</h3>
        <p>
          Weekly, biweekly, or monthly visits to keep your home under control.
        </p>
      </article>
      <article>
        <span>➕</span>
        <h3>Add-On Services</h3>
        <p>
          Customize your clean with extras like baseboards, bed making, laundry,
          and more.
        </p>
      </article>
    </div>
    <div class="center">
      <a class="button glass" href="/services">
        See All Services →
      </a>
    </div>
  </section>

  <section class="why section">
    <div>
      <p class="eyebrow">WHY CLEANING BY CASSI?</p>
      <h2>
        Your home deserves <em>personal attention.</em>
      </h2>
      <p>
        When you invite someone into your home, you want to know who is caring
        for it. I provide dependable, detailed cleaning with a personal touch.
      </p>
    </div>
    <div class="features">
      <div>
        💗 <strong>Personalized</strong>
        <small>Your home and needs are unique.</small>
      </div>
      <div>
        ✨ <strong>Detail-focused</strong>
        <small>The little things matter.</small>
      </div>
      <div>
        🐾 <strong>Pet-friendly</strong>
        <small>Four-legged family members are welcome.</small>
      </div>
      <div>
        💚 <strong>One familiar face</strong>
        <small>You know who's caring for your home.</small>
      </div>
    </div>
  </section>

  <div class="testimonials-wrap">
    <Testimonials />
  </div>

  <section class="final-cta section">
    <p class="eyebrow">READY FOR A FRESH START?</p>
    <h2>
      A brighter home is <em>one quote away.</em>
    </h2>
    <p>
      Let's find the cleaning plan that's right for your home in the{' '}
      {SERVICE_AREA} area.
    </p>
    <a href="/quote" class="button light">
      Get My Free Quote →
    </a>
    <small>No pressure. Just a simple quote tailored to your home.</small>
  </section>
  <ServiceAreaContact />
</PageLayout>

<style>
  :global(.home) {
    padding: 0;
    overflow: hidden;
    color: var(--ink);
    background: var(--surface);
  }

  .hero {
    position: relative;
    min-height: clamp(620px, 76vh, 850px);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: var(--purple-dark);
  }
  .hero::after {
    content: '';
    position: absolute;
    z-index: 4;
    left: -4%;
    right: -4%;
    bottom: -45px;
    height: 92px;
    border-radius: 50% 50% 0 0 / 58% 58% 0 0;
    background: var(--surface-solid);
    pointer-events: none;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 52%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(43, 17, 53, 0.91) 0%,
        rgba(76, 28, 78, 0.79) 27%,
        rgba(111, 20, 217, 0.28) 49%,
        rgba(20, 13, 29, 0.08) 72%
      ),
      linear-gradient(0deg, rgba(242, 75, 181, 0.19), transparent 46%);
  }
  .hero-content {
    position: relative;
    z-index: 3;
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: clamp(4.5rem, 8vw, 7.5rem) clamp(1.35rem, 7vw, 6rem)
      clamp(6rem, 10vw, 8rem);
    color: #fff;
  }
  .hero-eyebrow {
    margin: 0 0 0.8rem;
    color: #f9a7df;
    font-size: clamp(0.72rem, 1.2vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.23em;
  }
  .hero h1 {
    max-width: 690px;
    margin: 0;
    line-height: 0.86;
    text-shadow: 0 5px 24px rgba(25, 7, 28, 0.28);
  }
  .hero h1 span {
    display: block;
    color: #f381d1;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(4.6rem, 10vw, 8.8rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.045em;
  }
  .hero h1 strong {
    display: block;
    margin-top: 0.28em;
    color: #fff;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(2.75rem, 6vw, 5.6rem);
    font-weight: 400;
    letter-spacing: 0.015em;
    white-space: nowrap;
  }
  .hero-tagline {
    width: fit-content;
    margin: 1.4rem 0 1.6rem;
    padding-top: 1rem;
    border-top: 2px solid rgba(243, 129, 209, 0.82);
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    line-height: 1.25;
  }
  .hero-benefits {
    display: flex;
    gap: clamp(1rem, 3vw, 2.3rem);
    margin: 0 0 1.6rem;
  }
  .hero-benefits div {
    min-width: 92px;
    text-align: center;
  }
  .hero-benefits span {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin: 0 auto 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.58);
    border-radius: 50%;
    background: rgba(255, 203, 235, 0.16);
    font-size: 1.7rem;
    backdrop-filter: blur(5px);
  }
  .hero-benefits small {
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.08em;
  }
  .hero-quote {
    min-width: 235px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.58);
    background: linear-gradient(110deg, #7b22d5, #ed62bd);
    box-shadow: 0 14px 35px rgba(51, 10, 66, 0.28);
  }
  .hero-quote:hover {
    color: #fff;
  }
  .hero-note {
    margin: 1.1rem 0 0;
    color: rgba(255, 255, 255, 0.92);
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1rem;
    font-style: italic;
  }
  .hero-leaves {
    position: absolute;
    z-index: 2;
    color: rgba(197, 242, 56, 0.42);
    font-family: Georgia, serif;
    font-size: 10rem;
    line-height: 1;
    pointer-events: none;
  }
  .hero-leaves-top {
    top: -2rem;
    left: -1rem;
    transform: rotate(28deg);
  }
  .hero-leaves-bottom {
    right: -1rem;
    bottom: 1rem;
    transform: rotate(205deg);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.83rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 0.45rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button:focus-visible,
  .text-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }
  .glass,
  .light {
    color: var(--accent);
    border: 1px solid var(--accent);
    background: var(--surface-solid);
  }
  .glass:hover,
  .light:hover {
    color: var(--accent);
  }

  .section {
    padding: clamp(4rem, 7vw, 7rem) clamp(1.25rem, 7vw, 7rem);
  }
  .section h2 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.1;
    color: var(--ink);
  }
  .section h2 em {
    color: var(--emphasis);
    font-style: italic;
  }
  .section p:not(.eyebrow) {
    color: var(--muted);
    line-height: 1.8;
  }
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    background: var(--surface-solid);
  }
  .text-link {
    color: var(--accent);
    font-weight: 700;
  }
  .services {
    background: var(--surface-soft);
  }
  .heading {
    max-width: 760px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
    max-width: 1250px;
    margin: auto;
  }
  .cards article {
    min-width: 0;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 26px;
    background: var(--surface-solid);
    box-shadow: var(--shadow);
  }
  .cards article > span {
    font-size: 2rem;
  }
  .cards h3 {
    color: var(--ink);
  }
  .cards p {
    font-size: 0.94rem;
  }
  .cards .featured {
    background: var(--brand-gradient-soft);
  }
  .center {
    text-align: center;
    margin-top: 2.5rem;
  }
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    background: var(--brand-gradient-soft);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .features div {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface-solid);
  }
  .features strong,
  .features small {
    display: block;
  }
  .features strong {
    margin-top: 0.35rem;
    color: var(--ink);
  }
  .features small {
    margin-top: 0.3rem;
    color: var(--muted);
  }
  .testimonials-wrap {
    background: var(--surface-soft);
  }
  .final-cta {
    text-align: center;
    background: var(--brand-gradient-soft);
  }
  .final-cta p {
    max-width: 650px;
    margin-inline: auto;
  }
  .final-cta small {
    display: block;
    margin-top: 1rem;
    color: var(--muted);
  }
  .light {
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 690px;
      align-items: flex-end;
    }
    .hero-photo {
      object-position: 63% center;
    }
    .hero-shade {
      background:
        linear-gradient(
          90deg,
          rgba(43, 17, 53, 0.9) 0%,
          rgba(76, 28, 78, 0.68) 50%,
          rgba(31, 12, 38, 0.18) 100%
        ),
        linear-gradient(0deg, rgba(43, 17, 53, 0.64), transparent 60%);
    }
    .hero-content {
      padding-top: 5rem;
      padding-bottom: 7rem;
    }
    .intro,
    .why {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 710px;
    }
    .hero-photo {
      object-position: 60% center;
    }
    .hero-shade {
      background:
        linear-gradient(
          0deg,
          rgba(44, 15, 52, 0.92) 0%,
          rgba(71, 26, 72, 0.68) 57%,
          rgba(36, 16, 42, 0.22) 100%
        ),
        linear-gradient(90deg, rgba(111, 20, 217, 0.22), transparent 75%);
    }
    .hero-content {
      align-self: flex-end;
      padding: 8rem 1.15rem 6.5rem;
      text-align: center;
    }
    .hero-eyebrow {
      font-size: 0.68rem;
    }
    .hero h1 {
      margin-inline: auto;
    }
    .hero h1 span {
      font-size: clamp(4.1rem, 21vw, 6.2rem);
    }
    .hero h1 strong {
      margin-top: 0.34em;
      font-size: clamp(2.35rem, 11vw, 3.7rem);
      white-space: normal;
    }
    .hero-tagline {
      margin: 1.2rem auto 1.35rem;
      font-size: 1.12rem;
    }
    .hero-benefits {
      justify-content: center;
      gap: 0.45rem;
    }
    .hero-benefits div {
      min-width: 88px;
    }
    .hero-benefits span {
      width: 44px;
      height: 44px;
      font-size: 1.4rem;
    }
    .hero-benefits small {
      font-size: 0.62rem;
    }
    .hero-quote {
      width: min(320px, 100%);
    }
    .hero-note {
      font-size: 0.9rem;
    }
    .hero-leaves {
      font-size: 7rem;
      opacity: 0.72;
    }
    .section {
      padding: 3.75rem 1.25rem;
    }
    .cards,
    .features {
      grid-template-columns: 1fr;
    }
    .section h2 {
      font-size: 2.7rem;
    }
    .intro {
      text-align: center;
    }
  }

  @media (prefers-color-scheme: dark) {
    .hero::after {
      background: var(--surface-solid);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
