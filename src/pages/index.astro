---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import HeroCleaningGraphic from '../components/HeroCleaningGraphic.astro';
import { SITE_TITLE, SITE_DESCRIPTION, OWNER_NAME, SERVICE_AREA } from '../consts';
---
<!doctype html><html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head><body><Header /><main class="home">
<section class="hero"><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">CLEANING BY CASSI</p><h1>A Cleaner<br/>Home for a<br/><em>Brighter You</em></h1><p class="lead">Reliable, detailed residential cleaning services so you can spend more time doing what you love.</p><div class="actions"><a class="button primary" href="/quote">Get a Free Quote <span>→</span></a><a class="button glass" href="/services">Explore Services</a></div></div><div class="hero-art"><HeroCleaningGraphic /></div></div><div class="care-strip"><span class="spark">✨</span><div><strong>Detailed care, done personally.</strong><small>One cleaner. One familiar face. One home at a time.</small></div></div><a class="client-card" href="/quote" aria-label="Get a quote — now accepting new clients"><picture><source srcset="/homepage-optimized.avif" type="image/avif"/><source srcset="/homepage-optimized.webp" type="image/webp"/><img src="/homepage.jpg" alt="Cleaning by Cassi accepting new clients" loading="eager" fetchpriority="high"/></picture></a></section>
<section class="intro section"><div><p class="eyebrow">HI, I'M CASSI! 👋</p><h2>A cleaner home means <em>more time for what matters.</em></h2></div><div><p>Life gets busy. Between work, family, pets, and everything else on your plate, keeping up with the house can feel like one more thing to manage.</p><p>That's where I come in. My goal isn't just to make your home clean — it's to make your life a little easier.</p><a class="text-link" href="/about">Meet {OWNER_NAME} →</a></div></section>
<section class="services section"><div class="heading"><p class="eyebrow">WHAT I DO</p><h2>Cleaning that fits <em>your home & your life.</em></h2><p>Every home is different, which is why your cleaning should be, too.</p></div><div class="cards"><article><span>🧽</span><h3>Standard Cleaning</h3><p>Regular upkeep to keep your home fresh, comfortable, and clean.</p></article><article class="featured"><span>✨</span><h3>Deep Cleaning</h3><p>A detailed reset for homes that need a little extra TLC.</p></article><article><span>🏡</span><h3>Recurring Cleaning</h3><p>Weekly, biweekly, or monthly visits to keep your home under control.</p></article><article><span>➕</span><h3>Add-On Services</h3><p>Customize your clean with extras like baseboards, bed making, laundry, and more.</p></article></div><div class="center"><a class="button glass" href="/services">See All Services →</a></div></section>
<section class="why section"><div><p class="eyebrow">WHY CLEANING BY CASSI?</p><h2>Your home deserves <em>personal attention.</em></h2><p>When you invite someone into your home, you want to know who is caring for it. I provide dependable, detailed cleaning with a personal touch.</p></div><div class="features"><div>💗 <strong>Personalized</strong><small>Your home and needs are unique.</small></div><div>✨ <strong>Detail-focused</strong><small>The little things matter.</small></div><div>🐾 <strong>Pet-friendly</strong><small>Four-legged family members are welcome.</small></div><div>💚 <strong>One familiar face</strong><small>You know who's caring for your home.</small></div></div></section><div class="testimonials-wrap"><Testimonials /></div><section class="final-cta section"><p class="eyebrow">READY FOR A FRESH START?</p><h2>A brighter home is <em>one quote away.</em></h2><p>Let's find the cleaning plan that's right for your home in the {SERVICE_AREA} area.</p><a href="/quote" class="button light">Get My Free Quote →</a><small>No pressure. Just a simple quote tailored to your home.</small></section></main><Footer /></body></html>
<style>
:global(body){background:#07104d}.home{padding:0;overflow:hidden;color:#fff;background:#07104d}.hero{position:relative;padding:clamp(3rem,6vw,6rem) clamp(1.25rem,6vw,6rem) clamp(3.5rem,6vw,5rem);background:radial-gradient(circle at 83% 28%,rgba(117,39,238,.34),transparent 28%),radial-gradient(circle at 68% 42%,rgba(18,77,255,.76),transparent 40%),radial-gradient(circle at 8% 30%,rgba(112,36,232,.45),transparent 35%),linear-gradient(135deg,#090b55 0%,#0926a5 50%,#07104d 100%);isolation:isolate}.hero:before,.hero:after{content:"";position:absolute;border-radius:50%;pointer-events:none;z-index:-1}.hero:before{width:36rem;height:36rem;left:-24rem;top:10rem;border:5rem solid rgba(159,87,255,.09)}.hero:after{width:28rem;height:28rem;right:-18rem;bottom:-13rem;border:4rem solid rgba(245,54,183,.10)}.hero-grid{width:min(1120px,100%);margin:auto;display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(2rem,4vw,4rem);align-items:center}.hero-copy{padding-block:1rem}.eyebrow{color:#ff8ad8;font-size:.83rem;font-weight:800;letter-spacing:.3em;text-transform:uppercase}.hero h1{margin:.6rem 0 1.5rem;color:#fff;font-family:'DM Serif Display',serif;font-size:clamp(3.5rem,6vw,6rem);line-height:.91;letter-spacing:-.025em}.hero h1 em{display:inline;color:#ff79c9;font-style:italic}.lead{max-width:600px;color:rgba(255,255,255,.88);font-size:clamp(1.05rem,1.8vw,1.3rem);line-height:1.55}.actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:.9rem 1.5rem;border-radius:999px;font-weight:800;transition:transform .2s ease,box-shadow .2s ease}.button:hover{transform:translateY(-2px)}.primary{color:#fff;background:linear-gradient(100deg,#7024e8,#f536b7);box-shadow:0 12px 30px rgba(245,54,183,.3)}.glass{color:#fff;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);backdrop-filter:blur(12px)}.hero-art{position:relative;width:min(88%,455px);justify-self:center;isolation:isolate}.hero-art:before{content:"";position:absolute;inset:7% 4%;z-index:-1;border-radius:50%;background:radial-gradient(ellipse at center,rgba(35,70,255,.18) 0%,rgba(44,49,220,.09) 40%,transparent 72%);filter:blur(22px)}.hero-art :global(img){mix-blend-mode:screen;opacity:.93;filter:saturate(1.08) contrast(1.06) drop-shadow(0 15px 25px rgba(12,25,130,.18));-webkit-mask-image:radial-gradient(ellipse 72% 72% at 50% 52%,#000 48%,rgba(0,0,0,.9) 63%,rgba(0,0,0,.35) 78%,transparent 94%);mask-image:radial-gradient(ellipse 72% 72% at 50% 52%,#000 48%,rgba(0,0,0,.9) 63%,rgba(0,0,0,.35) 78%,transparent 94%)}.care-strip{width:min(760px,82%);margin:1rem auto 1.5rem;display:flex;align-items:center;gap:1rem;padding:1rem 1.4rem;border:1px solid rgba(218,200,255,.42);border-radius:28px;background:rgba(38,31,127,.38);box-shadow:0 14px 35px rgba(0,0,0,.14);backdrop-filter:blur(14px)}.spark{display:grid;place-items:center;width:58px;height:58px;flex:0 0 58px;border-radius:50%;background:linear-gradient(135deg,#4a2db5,#7024e8);font-size:1.5rem}.care-strip strong,.care-strip small{display:block}.care-strip strong{font-size:1.15rem}.care-strip small{margin-top:.2rem;color:rgba(255,255,255,.83)}.client-card{position:relative;display:block;width:min(780px,78%);margin:0 auto;border-radius:30px;overflow:hidden;background:rgba(255,255,255,.025);box-shadow:0 20px 45px rgba(0,0,0,.18);transition:transform .2s ease}.client-card:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(7,16,77,.12),transparent 14%,transparent 86%,rgba(7,16,77,.12));mix-blend-mode:multiply}.client-card:hover{transform:translateY(-3px)}.client-card picture,.client-card img{display:block;width:100%}.client-card img{height:auto;opacity:.94;filter:saturate(.96) contrast(.99)}.section{padding:clamp(4rem,7vw,7rem) clamp(1.25rem,7vw,7rem)}.section h2{font-family:'DM Serif Display',serif;font-size:clamp(2.5rem,5vw,4.5rem);line-height:1.02;color:#fff}.section h2 em{color:#ff79c9;font-style:italic}.section p{color:rgba(255,255,255,.78);line-height:1.8}.intro{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;background:radial-gradient(circle at 15% 50%,rgba(112,36,232,.28),transparent 30%),#07104d}.text-link{color:#ff8ad8;font-weight:800}.services{background:radial-gradient(circle at 85% 10%,rgba(18,77,255,.35),transparent 35%),#090b55}.heading{max-width:760px;margin:0 auto 3rem;text-align:center}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem;max-width:1250px;margin:auto}.cards article{padding:2rem;border:1px solid rgba(255,255,255,.16);border-radius:26px;background:rgba(255,255,255,.07);box-shadow:0 15px 35px rgba(0,0,0,.16);backdrop-filter:blur(10px)}.cards article>span{font-size:2rem}.cards h3{color:#fff}.cards p{font-size:.94rem}.cards .featured{background:linear-gradient(145deg,#7024e8,#d62cba);border-color:transparent}.center{text-align:center;margin-top:2.5rem}.why{display:grid;grid-template-columns:1fr 1fr;gap:5rem;background:radial-gradient(circle at 90% 50%,rgba(245,54,183,.2),transparent 30%),linear-gradient(135deg,#07104d,#0a1b76)}.features{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.features div{padding:1.4rem;border:1px solid rgba(255,255,255,.15);border-radius:22px;background:rgba(255,255,255,.07)}.features strong,.features small{display:block}.features strong{margin-top:.35rem;color:#fff}.features small{margin-top:.3rem;color:rgba(255,255,255,.7)}.testimonials-wrap{background:#090b55}.final-cta{text-align:center;background:radial-gradient(circle at 50% 0%,rgba(18,77,255,.7),transparent 48%),linear-gradient(135deg,#7024e8,#07104d)}.final-cta p{max-width:650px;margin-inline:auto}.final-cta small{display:block;margin-top:1rem;color:rgba(255,255,255,.75)}.light{margin-top:1rem;background:#fff;color:#4c168e}
@media(max-width:900px){.hero-grid,.intro,.why{grid-template-columns:1fr}.hero-copy{text-align:center}.lead{margin-inline:auto}.actions{justify-content:center}.hero-art{grid-row:2;width:min(430px,72vw)}.care-strip{width:min(680px,100%)}.client-card{width:min(700px,100%)}.cards{grid-template-columns:1fr 1fr}.intro,.why{gap:2.5rem}}
@media(max-width:600px){.hero{padding:2.5rem 1.15rem 3rem}.hero-grid{gap:1.5rem}.hero h1{font-size:clamp(3rem,14vw,4.3rem)}.lead{font-size:1.05rem}.actions .button{width:100%}.hero-art{width:min(340px,82vw)}.care-strip{padding:.85rem 1rem;border-radius:22px}.spark{width:46px;height:46px;flex-basis:46px}.care-strip strong{font-size:.92rem}.care-strip small{font-size:.75rem}.client-card{border-radius:22px}.section{padding:3.75rem 1.25rem}.cards,.features{grid-template-columns:1fr}.section h2{font-size:2.7rem}.intro{text-align:center}}
@media(prefers-reduced-motion:reduce){.button,.client-card{transition:none}}
</style>