---
import BlogPost from '../layouts/BlogPost.astro';

const title = 'Quote Request Received';
const description =
  'Thank you for requesting a quote from Cleaning by Cassi — we will be in touch soon!';
const pubDate = new Date();
---

<BlogPost
  title={title}
  description={description}
  pubDate={pubDate}
>
  <div class="success-page">

    <section class="success-card">
      <div class="sparkle">✦</div>

      <span class="eyebrow">✨ REQUEST RECEIVED</span>

      <h1>Thank You!</h1>

      <p>
        Your quote request has been sent, and I'll be in touch soon with your
        personalized cleaning quote. Check your inbox — a confirmation email
        is on its way!
      </p>

      <div class="hero-divider">
        <span></span>
        ✦
        <span></span>
      </div>

      <a href="/" class="home-button">
        Back to Home
        <span>→</span>
      </a>

      <div class="email-option">
        Need to reach me sooner?
        <a href="mailto:cassandramorris@cleaningbycassi.com">
          cassandramorris@cleaningbycassi.com
        </a>
      </div>
    </section>

  </div>
</BlogPost>

<style>

  .success-page {
    font-family: 'Poppins', sans-serif;
    display: flex;
    justify-content: center;
    padding: 3rem 1rem;
  }

  .success-page h1 {
    font-family: 'DM Serif Display', serif;
  }

  .success-card {
    max-width: 600px;
    width: 100%;
    padding: 3rem 2rem;
    border-radius: 26px;
    text-align: center;
    background: linear-gradient(
      135deg,
      rgba(106, 0, 244, 0.92),
      rgba(36, 107, 253, 0.92),
      rgba(255, 79, 163, 0.92)
    );
    color: white;
    box-shadow: 0 15px 35px rgba(91, 0, 214, 0.2);
  }

  .sparkle {
    margin-bottom: 0.5rem;
    font-size: 1.75rem;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .success-card h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1;
  }

  .success-card > p {
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.7;
    opacity: 0.95;
  }

  .hero-divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 180px;
    margin: 1.5rem auto;
    color: white;
  }

  .hero-divider span {
    height: 2px;
    flex: 1;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4)
    );
  }

  .hero-divider span:last-child {
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.4),
      transparent
    );
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.95rem 1.75rem;
    border-radius: 999px;
    background: white;
    color: #5b00d6;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    transition: 0.2s ease;
  }

  .home-button:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .email-option {
    margin-top: 1.5rem;
    font-size: 0.78rem;
  }

  .email-option a {
    color: white;
    font-weight: 700;
  }
</style>
