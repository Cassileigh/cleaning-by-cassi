---
import BlogPost from '../layouts/BlogPost.astro';

const title = 'Quote Request Received';
const description = 'Thank you for requesting a quote from Cleaning by Cassi — I will be in touch soon!';
const pubDate = new Date();
---

<BlogPost title={title} description={description} pubDate={pubDate}>
  <div class="success-page">
    <section class="success-card">
      <div class="success-icon">✨</div>
      <p class="eyebrow">Request Received</p>
      <h1>Thank you!</h1>
      <p>
        Your quote request has been sent. I'll review the details and be in touch with your personalized cleaning quote.
      </p>
      <div class="success-actions">
        <a href="/" class="primary-button">Back to Home →</a>
        <a href="/services" class="secondary-button">View Services</a>
      </div>
      <div class="email-option">
        Need to reach me sooner?<br />
        <a href="mailto:cassandramorris@cleaningbycassi.com">cassandramorris@cleaningbycassi.com</a>
      </div>
    </section>
  </div>
</BlogPost>

<style>
  .success-page { display: flex; justify-content: center; padding: 3rem 0; }
  .success-card {
    width: min(680px, 100%);
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: 32px;
    text-align: center;
    background: linear-gradient(145deg, rgba(245,200,223,0.42), rgba(232,224,248,0.62), rgba(226,243,229,0.5));
    box-shadow: var(--shadow);
  }
  .success-icon { font-size: 3rem; margin-bottom: 0.5rem; }
  .success-card h1 { margin-bottom: 1rem; }
  .success-card > p:not(.eyebrow) { max-width: 540px; margin: 0 auto; color: var(--muted); line-height: 1.8; }
  .success-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .primary-button, .secondary-button { display: inline-block; padding: 0.95rem 1.4rem; border-radius: 999px; font-weight: 700; }
  .primary-button { color: white; background: linear-gradient(135deg, var(--purple), var(--pink)); }
  .secondary-button { color: var(--ink); background: white; border: 1px solid rgba(48,41,54,0.12); }
  .email-option { margin-top: 1.7rem; color: var(--muted); font-size: 0.86rem; }
  .email-option a { color: var(--purple-dark); font-weight: 700; }
</style>
