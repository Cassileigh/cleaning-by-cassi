---
import PageLayout from '../layouts/PageLayout.astro';

const title = 'Quote Request Received';
const description =
  'Thank you for requesting a quote from Cleaning by Cassi — I will be in touch soon!';
---

<PageLayout title={title} description={description} noindex>
  <div class="success-page">
    <section class="success-card">
      <div class="success-icon">✨</div>
      <p class="eyebrow">Request Received</p>
      <h1>Thank you!</h1>
      <p>
        If you’ve just submitted your quote request, thank you! I’ll review the
        details and be in touch. If you reached this page without submitting,
        please use the quote form to send your request.
      </p>
      <div class="success-actions">
        <a href="/" class="primary-button">Back to Home →</a>
        <a href="/quote" class="secondary-button">Request a Quote</a>
      </div>
      <div class="email-option">
        Need to reach me sooner?<br /><a
          href="mailto:cassandramorris@cleaningbycassi.com"
          >cassandramorris@cleaningbycassi.com</a
        >
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .success-page {
    display: flex;
    justify-content: center;
    padding: 3rem 0;
  }
  .success-card {
    width: min(680px, 100%);
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--border);
    border-radius: 32px;
    text-align: center;
    background:
      radial-gradient(
        circle at 15% 10%,
        rgba(242, 75, 181, 0.16),
        transparent 28%
      ),
      radial-gradient(
        circle at 90% 15%,
        rgba(21, 72, 245, 0.15),
        transparent 30%
      ),
      linear-gradient(
        145deg,
        rgba(111, 20, 217, 0.1),
        rgba(167, 223, 36, 0.08)
      ),
      var(--surface-solid);
    box-shadow: var(--shadow);
  }
  .success-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .success-card h1 {
    margin-bottom: 1rem;
  }
  .success-card > p:not(.eyebrow) {
    max-width: 540px;
    margin: 0 auto;
    color: var(--muted);
    line-height: 1.8;
  }
  .success-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
  }
  .primary-button {
    color: white;
    background: var(--brand-gradient);
    box-shadow: 0 10px 24px rgba(111, 20, 217, 0.22);
  }
  .secondary-button {
    color: var(--ink);
    background: var(--surface-solid);
    border: 1px solid var(--purple);
  }
  .email-option {
    margin-top: 1.7rem;
    color: var(--muted);
    font-size: 0.86rem;
  }
  .email-option a {
    color: var(--purple);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  @media (prefers-color-scheme: dark) {
    .secondary-button {
      background: rgba(255, 255, 255, 0.04);
      border-color: #b78cff;
    }
    .email-option a {
      color: #d7baff;
    }
  }
  @media (max-width: 560px) {
    .success-page {
      padding: 1.5rem 0;
    }
    .success-actions a {
      width: 100%;
    }
  }
</style>
