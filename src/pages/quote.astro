---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, getBusinessTenure, BUSINESS_START_DATE, OWNER_NAME, SERVICE_AREA, CONTACT_EMAIL, getAge, BIRTHDATE } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Get a Free Quote | Cleaning by Cassi</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link hrel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --purple: #8f4fc7;
      --light-purple: #eee1fa;
      --pink: #dc65a6;
      --light-pink: #fde8f3;
      --blue: #5b86dc;
      --light-blue: #e8f0ff;
      --text: #36333a;
      --muted: #77717b;
      --white: #ffffff;
      --border: rgba(100, 75, 120, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Poppins", sans-serif;
      color: var(--text);
      min-height: 100vh;

      background:
        radial-gradient(
          circle at 10% 10%,
          rgba(220, 101, 166, 0.22),
          transparent 28%
        ),
        radial-gradient(
          circle at 90% 20%,
          rgba(91, 134, 220, 0.22),
          transparent 30%
        ),
        radial-gradient(
          circle at 50% 100%,
          rgba(143, 79, 199, 0.18),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #faf4ff,
          #f4f8ff 50%,
          #fff5fa
        );

      padding: 50px 18px 70px;
    }

    /* =========================
       PAGE HEADER
    ========================= */

    .page {
      max-width: 1050px;
      margin: 0 auto;
    }

    .hero {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 42px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 7px 16px;
      border-radius: 50px;

      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(143, 79, 199, 0.14);

      color: var(--purple);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;

      box-shadow: 0 8px 25px rgba(90, 65, 110, 0.07);
    }

    .hero h1 {
      font-family: "DM Serif Display", serif;
      font-weight: 400;

      font-size: clamp(3rem, 8vw, 5.2rem);
      line-height: 1.02;

      margin: 18px 0 15px;

      background:
        linear-gradient(
          90deg,
          var(--purple),
          var(--pink),
          var(--blue)
        );

      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero h2 {
      font-size: 1.05rem;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .hero p {
      max-width: 650px;
      margin: 0 auto;

      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.8;
    }

    /* =========================
       FORM
    ========================= */

    .quote-form {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .form-card {
      position: relative;

      background: rgba(255, 255, 255, 0.84);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);

      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: 26px;

      padding: 30px;

      box-shadow:
        0 18px 50px rgba(77, 57, 95, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 15px;

      margin-bottom: 23px;
    }

    .number {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 42px;
      height: 42px;
      flex-shrink: 0;

      border-radius: 13px;

      background: linear-gradient(
        135deg,
        var(--purple),
        var(--pink)
      );

      color: white;
      font-size: 0.82rem;
      font-weight: 700;

      box-shadow: 0 8px 20px rgba(143, 79, 199, 0.22);
    }

    .section-heading h3 {
      font-family: "DM Serif Display", serif;
      font-size: 1.65rem;
      font-weight: 400;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 0.76rem;
      margin-top: 2px;
    }

    /* =========================
       INPUTS
    ========================= */

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 17px;
    }

    .field {
      display: flex;
      flex-direction: column;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      color: #4d4751;
      font-size: 0.78rem;
      font-weight: 600;
      margin-bottom: 7px;
    }

    .required {
      color: var(--pink);
    }

    input,
    select,
    textarea {
      width: 100%;

      padding: 13px 15px;

      border: 1px solid var(--border);
      border-radius: 13px;

      background: rgba(255, 255, 255, 0.9);

      color: var(--text);
      font-family: "Poppins", sans-serif;
      font-size: 0.84rem;

      outline: none;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }

    input::placeholder,
    textarea::placeholder {
      color: #aaa3ad;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: rgba(143, 79, 199, 0.45);

      box-shadow:
        0 0 0 4px rgba(143, 79, 199, 0.08);

      transform: translateY(-1px);
    }

    textarea {
      min-height: 145px;
      resize: vertical;
    }

    /* =========================
       SELECTABLE OPTIONS
    ========================= */

    .options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 11px;
    }

    .option {
      position: relative;
    }

    .option input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .option label {
      display: flex;
      align-items: center;
      gap: 10px;

      min-height: 50px;

      margin: 0;
      padding: 11px 14px;

      border: 1px solid var(--border);
      border-radius: 14px;

      background: rgba(255, 255, 255, 0.76);

      cursor: pointer;

      font-size: 0.78rem;
      font-weight: 500;

      transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .option label:hover {
      transform: translateY(-2px);
      box-shadow: 0 7px 18px rgba(75, 55, 90, 0.07);
    }

    .option label::before {
      content: "";

      width: 19px;
      height: 19px;
      flex-shrink: 0;

      border: 2px solid #d2ccd5;
      border-radius: 6px;

      background: white;
    }

    .option input:checked + label {
      border-color: rgba(143, 79, 199, 0.45);

      background:
        linear-gradient(
          135deg,
          rgba(238, 225, 250, 0.9),
          rgba(253, 232, 243, 0.9)
        );

      box-shadow:
        0 7px 20px rgba(143, 79, 199, 0.08);
    }

    .option input:checked + label::before {
      background: var(--purple);
      border-color: var(--purple);

      box-shadow:
        inset 0 0 0 3px white;
    }

    .radio label::before {
      border-radius: 50%;
    }

    .radio input:checked + label::before {
      background: var(--pink);
      border-color: var(--pink);

      box-shadow:
        inset 0 0 0 4px white;
    }

    /* =========================
       NOTES
    ========================= */

    .note {
      margin-top: 15px;

      padding: 14px 16px;

      border-radius: 13px;

      background: linear-gradient(
        135deg,
        rgba(253, 232, 243, 0.75),
        rgba(238, 225, 250, 0.75)
      );

      color: #665d68;

      font-size: 0.74rem;
      line-height: 1.65;
    }

    .note strong {
      color: var(--purple);
    }

    /* =========================
       DISCLAIMER
    ========================= */

    .disclaimer {
      padding: 16px 18px;

      border-radius: 14px;

      background: rgba(246, 244, 247, 0.8);

      color: #77717b;

      font-size: 0.7rem;
      line-height: 1.7;
    }

    .disclaimer strong {
      color: #57505b;
    }

    /* =========================
       SUBMIT
    ========================= */

    .submit-card {
      text-align: center;

      padding: 38px 25px;

      border-radius: 28px;

      background:
        linear-gradient(
          135deg,
          rgba(143, 79, 199, 0.95),
          rgba(220, 101, 166, 0.94),
          rgba(91, 134, 220, 0.95)
        );

      box-shadow:
        0 20px 50px rgba(95, 65, 120, 0.18);

      color: white;
    }

    .submit-card h3 {
      font-family: "DM Serif Display", serif;
      font-size: 2rem;
      font-weight: 400;
      margin-bottom: 8px;
    }

    .submit-card p {
      max-width: 550px;
      margin: 0 auto 22px;

      font-size: 0.78rem;
      line-height: 1.7;

      opacity: 0.92;
    }

    .submit-button {
      border: none;

      padding: 15px 31px;

      border-radius: 50px;

      background: white;
      color: var(--purple);

      font-family: "Poppins", sans-serif;
      font-size: 0.82rem;
      font-weight: 700;

      cursor: pointer;

      box-shadow:
        0 10px 25px rgba(50, 30, 70, 0.16);

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .submit-button:hover {
      transform: translateY(-3px);

      box-shadow:
        0 14px 30px rgba(50, 30, 70, 0.22);
    }

    .privacy {
      margin-top: 13px;

      font-size: 0.66rem;
      opacity: 0.78;
    }

    /* =========================
       FOOTER BRAND MOMENT
    ========================= */

    .brand-message {
      text-align: center;

      max-width: 650px;

      margin: 48px auto 0;
    }

    .brand-message .sparkles {
      font-size: 1.1rem;
      letter-spacing: 5px;
      margin-bottom: 10px;
    }

    .brand-message h3 {
      font-family: "DM Serif Display", serif;
      font-size: 1.7rem;
      font-weight: 400;

      margin-bottom: 7px;
    }

    .brand-message p {
      color: var(--muted);

      font-size: 0.78rem;
      line-height: 1.8;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 680px) {

      body {
        padding: 32px 12px 50px;
      }

      .hero {
        margin-bottom: 28px;
      }

      .hero h1 {
        font-size: 3rem;
      }

      .hero p {
        font-size: 0.82rem;
      }

      .form-card {
        padding: 22px 17px;
        border-radius: 21px;
      }

      .grid,
      .options {
        grid-template-columns: 1fr;
      }

      .section-heading {
        margin-bottom: 19px;
      }

      .section-heading h3 {
        font-size: 1.45rem;
      }

      .number {
        width: 38px;
        height: 38px;
      }

      .submit-card {
        border-radius: 22px;
        padding: 32px 20px;
      }

      .submit-card h3 {
        font-size: 1.8rem;
      }
    }
  </style>
</head>

<body>

  <main class="page">

    <!-- =========================
         HERO
    ========================= -->

    <header class="hero">

      <span class="eyebrow">
        ✨ Cleaning by Cassi
      </span>

      <h1>
        Let’s Make Your<br>
        Home Shine!
      </h1>

      <h2>
        Request Your Free Quote
      </h2>

      <p>
        Tell me a little about your home and what you're looking for.
        Every quote is customized to fit your home, your needs, and
        the level of cleaning you’re looking for.
      </p>

    </header>


    <!-- =========================
         QUOTE FORM
    ========================= -->

    <form
      class="quote-form"
      action="YOUR_CLOUDFLARE_FORM_ENDPOINT"
      method="POST"
    >

      <!-- =========================
           01 — ABOUT YOU
      ========================= -->

      <section class="form-card">

        <div class="section-heading">

          <span class="number">01</span>

          <div>
            <h3>About You</h3>
            <p>Let’s start with the basics.</p>
          </div>

        </div>


        <div class="grid">

          <div class="field">

            <label for="name">
              Full Name <span class="required">*</span>
            </label>

            <input
              id="name"
              name="name"
              type="text"
              placeholder="Your name"
              required
            >

          </div>


          <div class="field">

            <label for="email">
              Email Address <span class="required">*</span>
            </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
            >

          </div>


          <div class="field">

            <label for="phone">
              Phone Number <span class="required">*</span>
            </label>

            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="(555) 555-5555"
              required
            >

          </div>


          <div class="field">

            <label for="contact">
              Preferred Contact Method
            </label>

            <select
              id="contact"
              name="preferred_contact"
            >
              <option value="">Choose one</option>
              <option>Email</option>
              <option>Phone</option>
              <option>Text</option>
            </select>

          </div>

        </div>

      </section>


      <!-- =========================
           02 — YOUR HOME
      ========================= -->

      <section class="form-card">

        <div class="section-heading">

          <span class="number">02</span>

          <div>
            <h3>Your Home</h3>
            <p>A few details help me prepare your quote.</p>
          </div>

        </div>


        <div class="grid">

          <div class="field full">

            <label for="address">
              Home Address
            </label>

            <input
              id="address"
              name="address"
              type="text"
              placeholder="Street, city, state & ZIP"
            >

          </div>


          <div class="field">

            <label for="home_type">
              Type of Home
            </label>

            <select
              id="home_type"
              name="home_type"
            >
              <option value="">Choose one</option>
              <option>House</option>
              <option>Apartment</option>
              <option>Condo</option>
              <option>Townhome</option>
              <option>Other</option>
            </select>

          </div>


          <div class="field">

            <label for="bedrooms">
              Bedrooms
            </label>

            <select
              id="bedrooms"
              name="bedrooms"
            >
              <option value="">Choose one</option>
              <option>Studio</option>
              <option>1</option>
              <option>2</option>
              <option>3</option>
              <option>4</option>
              <option>5+</option>
            </select>

          </div>


          <div class="field">

            <label for="bathrooms">
              Bathrooms
            </label>

            <select
              id="bathrooms"
              name="bathrooms"
            >
              <option value="">Choose one</option>
              <option>1</option>
              <option>1.5</option>
              <option>2</option>
              <option>2.5</option>
              <option>3</option>
              <option>3.5</option>
              <option>4+</option>
            </select>

          </div>


          <div class="field">

            <label for="sqft">
              Approximate Square Footage
            </label>

            <input
              id="sqft"
              name="square_footage"
              type="text"
              placeholder="Example: 1,500 sq. ft."
            >

          </div>

        </div>

      </section>


      <!-- =========================
           03 — CLEANING SERVICE
      ========================= -->

      <section class="form-card">

        <div class="section-heading">

          <span class="number">03</span>

          <div>
            <h3>Your Cleaning</h3>
            <p>What type of cleaning are you looking for?</p>
          </div>

        </div>


        <div class="options">

          <div class="option radio">

            <input
              id="standard"
              type="radio"
              name="cleaning_service"
              value="Standard Cleaning"
              required
            >

            <label for="standard">
              🧹 Standard Cleaning
            </label>

          </div>


          <div class="option radio">

            <input
              id="deep"
              type="radio"
              name="cleaning_service"
              value="Deep Cleaning"
            >

            <label for="deep">
              ✨ Deep Cleaning
            </label>

          </div>


          <div class="option radio">

            <input
              id="first_time"
              type="radio"
              name="cleaning_service"
              value="First-Time Cleaning"
            >

            <label for="first_time">
              🏡 First-Time Cleaning
            </label>

          </div>


          <div class="option radio">

            <input
              id="move_in"
              type="radio"
              name="cleaning_service"
              value="Move-In Cleaning"
            >

            <label for="move_in">
              📦 Move-In Cleaning
            </label>

          </div>


          <div class="option radio">

            <input
              id="move_out"
              type="radio"
              name="cleaning_service"
              value="Move-Out Cleaning"
            >

            <label for="move_out">
              🚚 Move-Out Cleaning
            </label>

          </div>


          <div class="option radio">

            <input
              id="other"
              type="radio"
              name="cleaning_service"
              value="Other"
            >

            <label for="other">
              💕 Other
            </label>

          </div>

        </div>

      </section>


      <!-- =========================
           04 — FREQUENCY
      ========================= -->

      <section class="form-card">

        <div class="section-heading">

          <span class="number">04</span>

          <div>
            <h3>How Often?</h3>
            <p>Choose the cleaning schedule that fits your needs.</p>
          </div>

        </div>


        <div class="options">

          <div class="option radio">

            <input
              id="one_time"
              type="radio"
              name="frequency"
              value="One-Time"
            >

            <label for="one_time">
              One-Time
            </label>

          </div>


          <div class="option radio">

            <input
              id="weekly"
              type="radio"
              name="frequency"
              value="Weekly"
            >

            <label for="weekly">
              Weekly
            </label>

          </div>


          <div class="option radio">

            <input
              id="biweekly"
              type="radio"
              name="frequency"
              value="Every 2 Weeks"
            >

