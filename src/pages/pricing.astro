---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const cleaningFrequencies = [
  { name: 'Weekly', price: 'Base Rate' },
  { name: 'Bi-Weekly', price: 'Base + $5' },
  { name: 'Monthly', price: 'Base + $10' },
];

const roomRates = [
  { icon: '🛏️', name: 'Bedroom', unit: 'per room', price: '$15' },
  { icon: '🛋️', name: 'Living Space', unit: 'per room', price: '$15' },
  { icon: '🛁', name: 'Full Bathroom', unit: 'per bathroom', price: '$25' },
  { icon: '🚽', name: 'Half Bathroom', unit: 'per bathroom', price: '$15' },
  { icon: '🍴', name: 'Kitchen / Dining', unit: 'per room', price: '$35' },
];

const addOns = ['Window Tracks & Sills','Baseboards','Doors & Door Frames','Cabinet Fronts','Detailed Shower & Tub Cleaning','Trash Can Cleaning & Sanitizing','Bed Making','Laundry','Extra Pet Hair Removal','Wall Spot Cleaning','Cobweb Removal','Detailed Floor Edges & Corners','High & Hard-to-Reach Areas'];
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={`Pricing | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main class="pricing-page">
      <section class="pricing-hero"><p class="eyebrow">Simple, Personalized Pricing</p><h1>Cleaning prices that fit your home.</h1><p>Every home is different, so this sheet is a starting point. Your final quote is based on your home's size, condition, rooms, and requested services.</p><a href="/quote" class="primary-button">Get My Free Quote →</a></section>

      <section class="pricing-section soft-pink"><div class="section-heading"><span class="section-icon">📅</span><div><p class="eyebrow">Recurring Service</p><h2>Cleaning Frequency</h2></div></div><div class="pricing-list">{cleaningFrequencies.map((item) => <div class="pricing-row"><span>{item.name}</span><strong>{item.price}</strong></div>)}</div></section>

      <section class="pricing-section soft-lavender"><div class="section-heading"><span class="section-icon">🏠</span><div><p class="eyebrow">Base Price Sheet</p><h2>Base Room Rates</h2></div></div><div class="room-grid">{roomRates.map((room) => <article class="room-card"><span class="room-icon">{room.icon}</span><div><h3>{room.name}</h3><small>{room.unit}</small></div><strong>{room.price}</strong></article>)}</div></section>

      <section class="first-cleaning"><div class="big-icon">✨</div><div><p class="eyebrow">First Visit</p><h2>First-Time Cleanings</h2><p>All first-time cleanings are priced separately so I can get the home to a good base point before regular cleaning rates begin.</p></div></section>

      <section class="pricing-section soft-green"><div class="section-heading"><span class="section-icon">➕</span><div><p class="eyebrow">Customize Your Clean</p><h2>Add-On Services</h2></div></div><p class="section-copy">Add-ons are quoted individually based on the size, condition, and time required.</p><div class="addon-grid">{addOns.map((addon) => <div class="addon-card"><span>✦</span>{addon}</div>)}</div><div class="fine-print"><p><strong>🛏️ Bed Making:</strong> Clean sheets must be provided and left out. Please remove soiled sheets before arrival.</p><p><strong>🧺 Laundry:</strong> Wash, dry, and fold only.</p></div></section>

      <section class="pricing-note"><span>💗</span><div><h2>A Note About Pricing</h2><p>Pricing may vary based on the size and condition of the home, cleaning needs, and additional services requested. Deep-cleaning tasks and special requests may be quoted separately.</p></div></section>

      <section class="pricing-cta"><p class="eyebrow">Ready When You Are</p><h2>Let's find the right cleaning plan for your home.</h2><p>No pressure — just a simple, personalized quote.</p><a href="/quote" class="cta-button">Get a Free Quote →</a></section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .pricing-page { overflow:hidden; }
  .pricing-hero { max-width:820px; margin:0 auto 4rem; text-align:center; }
  .pricing-hero h1 { margin-bottom:1rem; font-size:clamp(3.2rem,7vw,5.6rem); }
  .pricing-hero p:not(.eyebrow) { max-width:700px; margin:0 auto 1.8rem; color:var(--muted); line-height:1.8; }
  .primary-button,.cta-button { display:inline-flex; align-items:center; justify-content:center; padding:.95rem 1.55rem; border-radius:999px; color:white; background:var(--brand-gradient); font-weight:700; box-shadow:0 10px 25px rgba(111,20,217,.22); }

  .pricing-section { margin:0 0 2rem; padding:clamp(1.5rem,4vw,2.4rem); border:1px solid var(--border); border-radius:28px; }
  .soft-pink { background:linear-gradient(145deg, rgba(242,75,181,.12), rgba(111,20,217,.04)); }
  .soft-lavender { background:linear-gradient(145deg, rgba(111,20,217,.11), rgba(21,72,245,.06)); }
  .soft-green { background:linear-gradient(145deg, rgba(167,223,36,.13), rgba(21,72,245,.04)); }

  .section-heading { display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem; }
  .section-icon,.big-icon { display:grid; place-items:center; width:58px; height:58px; flex-shrink:0; border:1px solid var(--border); border-radius:18px; background:var(--surface-solid); box-shadow:0 8px 22px rgba(49,24,95,.08); font-size:1.6rem; }
  .section-heading h2,.first-cleaning h2,.pricing-note h2,.pricing-cta h2 { margin:0; }

  .pricing-list { overflow:hidden; border:1px solid var(--border); border-radius:20px; background:var(--surface-solid); box-shadow:var(--shadow); }
  .pricing-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 1.25rem; border-bottom:1px solid var(--border); }
  .pricing-row:last-child { border-bottom:0; }
  .pricing-row strong { color:var(--purple); }

  .room-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .room-card { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:.9rem; padding:1.1rem; border:1px solid var(--border); border-radius:20px; background:var(--surface-solid); box-shadow:0 8px 24px rgba(49,24,95,.07); }
  .room-icon { font-size:1.5rem; }
  .room-card h3 { margin:0; font-size:1.35rem; }
  .room-card small { color:var(--muted); }
  .room-card strong { color:var(--purple); font-size:1.15rem; }

  .first-cleaning,.pricing-note { display:flex; align-items:flex-start; gap:1.2rem; margin:2rem 0; padding:1.7rem; border:1px solid var(--border); border-radius:24px; background:var(--surface-solid); box-shadow:var(--shadow); }
  .first-cleaning p:last-child,.pricing-note p { margin-bottom:0; color:var(--muted); line-height:1.75; }
  .section-copy { color:var(--muted); }

  .addon-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; }
  .addon-card { display:flex; align-items:center; gap:.65rem; padding:.9rem 1rem; border:1px solid var(--border); border-radius:16px; background:var(--surface-solid); font-weight:600; box-shadow:0 6px 18px rgba(49,24,95,.06); }
  .addon-card span { color:var(--pink); }
  .fine-print { margin-top:1.2rem; padding:1rem 1.1rem; border:1px solid var(--border); border-radius:16px; background:var(--surface); }
  .fine-print p { margin:.3rem 0; font-size:.9rem; }
  .pricing-note > span { font-size:1.8rem; }

  .pricing-cta { margin-top:3rem; padding:clamp(2rem,5vw,4rem); border-radius:30px; text-align:center; color:white; background:var(--brand-gradient); }
  .pricing-cta .eyebrow,.pricing-cta h2,.pricing-cta p { color:white; }
  .pricing-cta p:not(.eyebrow) { opacity:.92; }
  .pricing-cta .cta-button { background:white; color:var(--purple-dark); box-shadow:none; }

  @media (prefers-color-scheme:dark) { .pricing-row strong,.room-card strong { color:#d6b7ff; } }
  @media (max-width:700px) {
    .room-grid,.addon-grid { grid-template-columns:1fr; }
    .section-heading,.first-cleaning,.pricing-note { align-items:flex-start; }
    .pricing-row { font-size:.92rem; }
    .pricing-hero .primary-button,.pricing-cta .cta-button { width:100%; }
    .room-card { grid-template-columns:auto 1fr; }
    .room-card > strong { grid-column:2; }
  }
</style>