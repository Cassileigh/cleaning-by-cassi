{
  "repository": "Cassileigh/cleaning-by-cassi",
  "releaseRefPrefix": "cleaning",
  "routes": [
    "/",
    "/about",
    "/services",
    "/pricing",
    "/quote",
    "/quote-success",
    "/review",
    "/privacy"
  ],
  "noindexRoutes": ["/quote-success"],
  "browser": {
    "themeKey": null,
    "themeAttribute": null,
    "themeSetter": null,
    "statusRoute": null,
    "missingRoute": "/__integrity_missing_page",
    "turnstileCallback": "cleaningByCassiTurnstileLoad",
    "suites": {
      "responsive": [
        "tests/turnstile-engine.spec.cjs",
        "tests/navigation-engine.spec.cjs",
        "tests/responsive.spec.cjs",
        "tests/navigation.spec.cjs",
        "tests/keyboard.spec.cjs"
      ],
      "accessibility": [
        "tests/accessibility.spec.cjs",
        "tests/theme-assets.spec.cjs",
        "tests/quote-interactions.spec.cjs",
        "tests/navigation.spec.cjs",
        "tests/keyboard.spec.cjs",
        "tests/heading-contrast.spec.cjs"
      ],
      "webkit": [
        "tests/turnstile-engine.spec.cjs",
        "tests/navigation-engine.spec.cjs",
        "tests/quote-interactions.spec.cjs",
        "tests/navigation.spec.cjs",
        "tests/keyboard.spec.cjs"
      ]
    },
    "logoSelector": ".brand-logo",
    "externalSelector": ".facebook-link",
    "navigationRowBreakpoint": 0
  },
  "origin": "https://cleaningbycassi.com",
  "mail": {
    "sender": "Cleaning by Cassi <quotes@cleaningbycassi.com>",
    "address": "quotes@cleaningbycassi.com",
    "recipient": "cassandramorris@cleaningbycassi.com",
    "healthSubject": "Cleaning by Cassi — daily email health check — ",
    "customerConfirmation": true,
    "timeoutMs": 10000,
    "healthText": "Good morning, Cassi!\n\nThis is your daily 5:00 a.m. Central email health check for {date}.\n\nReceiving this confirms that the production website's scheduled job, mail credential, shared sending code, and delivery to your business mailbox worked for this message.\n\nIt does not test a customer's Turnstile challenge, their form submission, or delivery to every customer's inbox. Those paths have separate automated checks.\n\nNo customer quote was created. If this email is missing, check the delivery monitor and Cloudflare scheduled-event logs.\n\nCleaning by Cassi",
    "healthKeyPrefix": "daily-email-health/"
  },
  "form": {
    "route": "/quote",
    "selector": ".quote-form",
    "submit": "#quote-submit",
    "turnstile": "#quote-turnstile",
    "script": "/quote-form.js",
    "error": null,
    "endpoint": "/api/quote",
    "encoding": "form",
    "invalid": {
      "name": "Health Monitor",
      "email": "monitor@example.invalid",
      "phone": "5555555555",
      "faxNumber": "",
      "cf-turnstile-response": ""
    },
    "widget": "0x4AAAAAAEmmOovf3yTuy_Ua"
  },
  "rendering": "server",
  "csp": {
    "imageSources": ["'self'", "data:"],
    "headerResources": true,
    "generatedHashes": false,
    "externalStyles": true
  },
  "privateStatus": true,
  "revision": {
    "path": "/api/release",
    "key": "revision"
  },
  "assets": [
    "/turnstile-engine.js",
    "/navigation.js",
    "/header-logo-optimized.webp",
    "/robots.txt",
    "/sitemap-index.xml"
  ],
  "smoke": {
    "markers": {
      "/": "Cleaning by Cassi",
      "/quote": "0x4AAAAAAEmmOovf3yTuy_Ua",
      "/quote-success": "Quote Request Received",
      "/about": "Cassi",
      "/services": "Cleaning",
      "/pricing": "Pricing",
      "/review": "feedback",
      "/privacy": "information"
    },
    "statusChecks": ["worker", "quote", "protection", "delivery"],
    "rejectionCode": "turnstile-failed"
  },
  "images": [
