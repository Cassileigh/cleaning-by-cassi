      {
        "key": "worker",
        "requires": [],
        "ready": "operational",
        "detail": "Production Worker is responding",
        "failure": "Production Worker is responding"
      },
      {
        "key": "quote",
        "requires": [],
        "ready": "operational",
        "detail": "Quote handler is included in this application",
        "failure": "Quote handler is included in this application"
      },
      {
        "key": "protection",
        "requires": ["verification", "limiter"],
