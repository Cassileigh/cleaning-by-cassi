{
	"name": "cleaning-by-cassi",
	"description": "Public website and quote request service for Cleaning by Cassi.",
	"dependencies": {
		"@astrojs/cloudflare": "14.3.1",
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.3.2",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"wrangler": "4.130.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "node scripts/optimize-images.mjs && astro build",
		"cf-typegen": "wrangler types",
		"check": "npm run build && tsc --noEmit && wrangler deploy --dry-run",
		"audit": "npm audit --audit-level=high",
		"deploy": "wrangler deploy",
		"dev": "node scripts/optimize-images.mjs && astro dev",
		"preview": "npm run build && wrangler dev"
	},
	"overrides": {
		"sharp": "0.35.4"
	},
	"type": "module"
}
